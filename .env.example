# SiliconFlow OpenAI-compatible API
SILICONFLOW_API_KEY=sk-your-siliconflow-key
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1

# Model roles
SILICONFLOW_CHAT_MODEL=Qwen/Qwen3.5-397B-A17B
SILICONFLOW_FAST_MODEL=Qwen/Qwen3-30B-A3B
SILICONFLOW_SUMMARY_MODEL=deepseek-ai/DeepSeek-V4-Flash
SILICONFLOW_REVIEW_MODEL=Qwen/Qwen3.6-27B
SILICONFLOW_MERGE_MODEL=Qwen/Qwen3.6-27B

# DeepSeek official API: Wiki tool-use controller, table answer and final answer
DEEPSEEK_API_KEY=sk-your-deepseek-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_CHAT_MODEL=deepseek-v4-flash

# Section-level multilingual Wiki retrieval
WIKI_VECTOR_SEARCH_ENABLED=true
WIKI_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
WIKI_EMBEDDING_BATCH_SIZE=16
WIKI_RRF_K=60

# Paper parser: arXiv HTML fast path -> MinerU precision -> PyMuPDF degradation
PAPER_PARSER_MODE=auto
ARXIV_HTML_BASE_URL=https://arxiv.org/html
ARXIV_HTML_TIMEOUT_SECONDS=60
MINERU_API_TOKEN=your-mineru-token
MINERU_API_BASE_URL=https://mineru.net/api/v4
MINERU_MODEL_VERSION=vlm
MINERU_TIMEOUT_SECONDS=600
MINERU_POLL_INTERVAL_SECONDS=4

# Wiki Chat web fallback: off | duckduckgo
WEB_SEARCH_MODE=duckduckgo
WEB_SEARCH_TIMEOUT_SECONDS=5
WEB_SEARCH_MAX_RESULTS=5

# arXiv MCP: metadata/PDF requests are paced; downloaded files are managed cache.
ARXIV_API_URL=https://export.arxiv.org/api/query
ARXIV_PDF_BASE_URL=https://arxiv.org/pdf
ARXIV_USER_AGENT=LLM-WIKI/1.0 (+https://github.com/ouchfys/LLM-WIKI; contact: you@example.com)
ARXIV_REQUEST_INTERVAL_SECONDS=3.1
ARXIV_TIMEOUT_SECONDS=30
ARXIV_MAX_PDF_MB=50
# Empty means sources/papers/arxiv-cache inside this repository.
ARXIV_MCP_CACHE_DIR=
# Existing FastAPI service used by arxiv_import_paper.
LLM_WIKI_API_URL=http://127.0.0.1:8000

# Local Agent worker pool: running workers + durable queued submissions
AGENT_TASK_MAX_WORKERS=2
AGENT_TASK_QUEUE_CAPACITY=8

# Storage: local | oss
STORAGE_BACKEND=local
# Single-user local deployments can use one stable tenant. In a hosted app,
# derive this trusted value from authentication instead of request parameters.
STORAGE_TENANT_ID=local-user
STORAGE_ROOT_PREFIX=users/local-user

# Aliyun OSS, used only when STORAGE_BACKEND=oss
OSS_ENDPOINT=https://oss-cn-shenzhen.aliyuncs.com
OSS_BUCKET=your-oss-bucket
OSS_ACCESS_KEY_ID=your-oss-access-key-id
OSS_ACCESS_KEY_SECRET=your-oss-access-key-secret

# Conversation context. DeepSeek V4 Flash/Pro resolve to 1M by default.
# For another model, explicitly set its verified window. Optional application cap:
# PAPERWIKI_CONTEXT_WINDOW=1000000
# PAPERWIKI_CONTEXT_RUNTIME_LIMIT=1000000
PAPERWIKI_CONTEXT_OUTPUT_RESERVE=4096
PAPERWIKI_CONTEXT_SAFETY=2048
PAPERWIKI_CONTEXT_SUMMARY=8192
PAPERWIKI_CONTEXT_AUTO_COMPACT=true
# Optional. Defaults to .paperwiki/memory beside sessions.db.
# PAPERWIKI_MEMORY_ROOT=E:/path/to/paperwiki-memory
# Defaults scale with the effective window: trigger 80%, retain recent 16%.
# PAPERWIKI_CONTEXT_COMPACT_TRIGGER=800000
# PAPERWIKI_CONTEXT_COMPACT_KEEP=160000
# DSH-style tool-result retention. Full results stay in SQLite and remain readable by result_id.
PAPERWIKI_TOOL_MAX_INLINE_BYTES=50000
PAPERWIKI_TOOL_PRUNE_CHARS=8192
PAPERWIKI_TOOL_PRUNE_HEAD_CHARS=4096
PAPERWIKI_TOOL_PRUNE_TAIL_CHARS=1024
# Optional matching local tokenizer.json; otherwise explicitly estimated.
PAPERWIKI_TOKENIZER_PATH=
